  "info": {
    "title": "Scrapo Lead Hunter API",
    "description": "Independent, workspace-scoped REST API for the Scrapo Lead Hunter clients.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "workspace": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Workspace-Id"
      }
    },
    "schemas": {
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Northstar Digital"
          },
          "domain": {
            "type": "string",
            "example": "northstar.example"
          },
          "website": {
            "type": "string",
            "example": "https://northstar.example"
          },
          "description": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "employeeRange": {
            "type": "string"
          },
          "companyType": {
            "type": "string"
          },
          "agencyType": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "industries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hasWebService": {
            "type": "boolean"
          },
          "hasBackendService": {
            "type": "boolean"
          },
          "hasMobileService": {
            "type": "boolean"
          },
          "partnershipFitScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Northstar Digital"
          },
          "domain": {
            "type": "string",
            "example": "northstar.example"
          },
          "website": {
            "type": "string",
            "example": "https://northstar.example"
          },
          "description": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "employeeRange": {
            "type": "string"
          },
          "companyType": {
            "type": "string"
          },
          "agencyType": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "industries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hasWebService": {
            "type": "boolean"
          },
          "hasBackendService": {
            "type": "boolean"
          },
          "hasMobileService": {
            "type": "boolean"
          },
          "partnershipFitScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "CreateContactDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string",
            "example": "James Smith"
          },
          "role": {
            "type": "string",
            "example": "Founder"
          },
          "email": {
            "type": "string",
            "example": "james@example.com"
          },
          "emailStatus": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "GUESSED",
              "UNVERIFIED",
              "VERIFIED",
              "INVALID",
              "BOUNCED"
            ]
          },
          "emailSource": {
            "type": "string"
          },
          "linkedinUrl": {
            "type": "string"
          },
          "xUrl": {
            "type": "string"
          },
          "decisionMakerScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "contactConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "fullName"
        ]
      },
      "UpdateContactDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string",
            "example": "James Smith"
          },
          "role": {
            "type": "string",
            "example": "Founder"
          },
          "email": {
            "type": "string",
            "example": "james@example.com"
          },
          "emailStatus": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "GUESSED",
              "UNVERIFIED",
              "VERIFIED",
              "INVALID",
              "BOUNCED"
            ]
          },
          "emailSource": {
            "type": "string"
          },
          "linkedinUrl": {
            "type": "string"
          },
          "xUrl": {
            "type": "string"
          },
          "decisionMakerScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "contactConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "CreateLeadDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "contactId": {
            "type": "string",
            "format": "uuid"
          },
          "primarySource": {
            "type": "string",
            "enum": [
              "X",
              "REDDIT",
              "TELEGRAM",
              "WEB",
              "AGENCY_DIRECTORY",
              "MANUAL"
            ],
            "default": "MANUAL"
          },
          "leadType": {
            "type": "string",
            "enum": [
              "AGENCY_PARTNER",
              "ACTIVE_REQUIREMENT",
              "BUSINESS_OPPORTUNITY",
              "MANUAL"
            ],
            "default": "MANUAL"
          },
          "title": {
            "type": "string",
            "example": "Agency mobile delivery partnership"
          },
          "opportunitySummary": {
            "type": "string"
          },
          "recommendedPitch": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "ANALYZING",
              "QUALIFIED",
              "SHORTLISTED",
              "DRAFTED",
              "APPROVED",
              "CONTACTED",
              "FOLLOW_UP",
              "REPLIED",
              "INTERESTED",
              "MEETING",
              "PROPOSAL",
              "WON",
              "LOST",
              "NOT_INTERESTED",
              "DO_NOT_CONTACT",
              "INVALID"
            ]
          },
          "overallScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          }
        },
        "required": [
          "primarySource",
          "leadType",
          "title"
        ]
      },
      "UpdateLeadDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "contactId": {
            "type": "string",
            "format": "uuid"
          },
          "primarySource": {
            "type": "string",
            "enum": [
              "X",
              "REDDIT",
              "TELEGRAM",
              "WEB",
              "AGENCY_DIRECTORY",
              "MANUAL"
            ],
            "default": "MANUAL"
          },
          "leadType": {
            "type": "string",
            "enum": [
              "AGENCY_PARTNER",
