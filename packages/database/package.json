{
  "name": "@scrapo/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma/seed.ts --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@scrapo/eslint-config": "workspace:*",
    "@types/node": "^24.3.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
