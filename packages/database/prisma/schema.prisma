  profileUrl           String?    @map("profile_url")
  authorType           String?    @map("author_type")
  authorTypeConfidence Int        @default(0) @map("author_type_confidence")
  metadata             Json       @default("{}")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  workspace            Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact              Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, platform, username])
  @@map("social_profiles")
}

model TelegramSource {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  externalId   String?   @map("external_id")
  name         String
  username     String?
  type         String
  enabled      Boolean   @default(true)
  keywords     Json      @default("[]")
  notes        String?
  status       String    @default("NOT_CONFIGURED")
  lastSyncedAt DateTime? @map("last_synced_at")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, externalId])
  @@index([workspaceId, enabled])
  @@map("telegram_sources")
}

model DeviceToken {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash")
  token       String?
  platform    String
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, tokenHash])
  @@map("device_tokens")
}
