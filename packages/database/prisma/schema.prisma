generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum LeadSource {
  X
  REDDIT
  TELEGRAM
  WEB
  AGENCY_DIRECTORY
  LINKEDIN
  OTHER
  MANUAL
}

enum LeadType {
  AGENCY_PARTNER
  ACTIVE_REQUIREMENT
  BUSINESS_OPPORTUNITY
  MVP_STARTUP
  EXISTING_APP_FIX
  FIREBASE_API_SUPPORT
  APP_STORE_SUPPORT
  GENERAL_MOBILE_SUPPORT
  MANUAL
  INVALID
  PERMANENT_JOB
  OTHER
}

enum OpportunityUrgency {
  IMMEDIATE
  THIS_WEEK
  THIS_MONTH
  FLEXIBLE
  UNKNOWN
}

enum LeadStatus {
  NEW
  ANALYZING
  QUALIFIED
  SHORTLISTED
  DRAFTED
  APPROVED
  CONTACTED
  FOLLOW_UP
  REPLIED
  INTERESTED
  MEETING
  PROPOSAL
  WON
  LOST
  NOT_INTERESTED
  DO_NOT_CONTACT
  INVALID
  STALE
  ARCHIVED
}

enum LeadTemperature {
  HOT
  STRONG
  REVIEW
  WEAK
  REJECT
}

enum AnalysisStatus {
  NOT_ANALYZED
  QUEUED
  ANALYZING
  COMPLETED
  FAILED
}

enum OutreachRecommendation {
  AGENCY_PARTNERSHIP
  ACTIVE_REQUIREMENT
  MVP_STARTUP
  EXISTING_APP_FIX
  FIREBASE_API_SUPPORT
  APP_STORE_SUPPORT
  GENERAL_MOBILE_SUPPORT
  DO_NOT_CONTACT
}

enum RecommendedChannel {
  EMAIL
  X_REPLY
  X_DM
  REDDIT_REPLY
  TELEGRAM_REPLY
  LINKEDIN_CONNECT
  MANUAL_RESEARCH
  NONE
}

enum InvalidLeadReason {
  OTHER_FREELANCER
  SELF_PROMOTION
  SPAM
  BOT
  STUDENT_PROJECT
  PERMANENT_JOB_ONLY
  IRRELEVANT
  TUTORIAL
  NEWS
  JOB_AGGREGATOR
  COMPETITOR
  EXPIRED
  DUPLICATE
  INSUFFICIENT_INFORMATION
}

enum EmailStatus {
  UNKNOWN
  GUESSED
  LIKELY_VALID
  UNVERIFIED
  VERIFIED
  INVALID
  BOUNCED
}

enum ProcessingStatus {
  PENDING
  DISCOVERED
  FILTERING
  PROCESSING
  COMPANY_CREATED
  ANALYZING
  ENRICHING
  SCORED
  QUALIFIED
  PROCESSED
  REJECTED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
  X
  REDDIT
  TELEGRAM
  OTHER
}

enum OutreachStatus {
  GENERATED
  EDITED
  DRAFT
  DRAFT_CREATED
  APPROVED
  SENDING
  SENT
  DELIVERED
  REPLIED
  FOLLOW_UP_DUE
  FOLLOW_UP_SENT
  FAILED
  CANCELLED
  SUPPRESSED
}

enum OutreachApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ActionStatus {
  PENDING
  COMPLETED
  SKIPPED
  EXPIRED
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  APPROVAL_REQUIRED
  ACTIVE
  DISABLED
  CONNECTED
  REAUTH_REQUIRED
  ERROR
  DISCONNECTED
}

model User {
  id             String            @id @default(uuid()) @db.Uuid
  externalAuthId String            @unique @map("external_auth_id") @db.Uuid
  email          String            @unique
  displayName    String?           @map("display_name")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  memberships    WorkspaceMember[]
  auditLogs      AuditLog[]        @relation("AuditActor")
  notifications  Notification[]
  leadFeedback   LeadFeedback[]
  deviceTokens   DeviceToken[]

  @@map("users")
}

model Workspace {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  slug                        String                       @unique
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  members                     WorkspaceMember[]
  companies                   Company[]
  contacts                    Contact[]
  rawLeads                    RawLead[]
  leads                       Lead[]
  leadSignals                 LeadSignal[]
  leadScores                  LeadScore[]
  queries                     SearchQuery[]
  campaigns                   Campaign[]
  outreach                    OutreachMessage[]
  replies                     EmailReply[]
  activities                  Activity[]
  actions                     ActionItem[]
  socialProfiles              SocialProfile[]
  telegramSources             TelegramSource[]
  suppression                 SuppressionEntry[]
  statistics                  SourceStatistic[]
  integrations                IntegrationConnection[]
  jobs                        SystemJob[]
  aiUsage                     AiUsageLog[]
  discoveryRuns               DiscoveryRun[]
  discoveryQueryRuns          DiscoveryQueryRun[]
  shortlists                  Shortlist[]
  contactEnrichmentRecords    ContactEnrichmentRecord[]
  emailVerificationRecords    EmailVerificationRecord[]
  automations                 AutomationRule[]
  automationRuns              AutomationRun[]
  optimizationRecommendations OptimizationRecommendation[]
  notifications               Notification[]
  weeklyReports               WeeklyReport[]
  leadFeedback                LeadFeedback[]
  auditLogs                   AuditLog[]
  settings                    UserSettings?
  deviceTokens                DeviceToken[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Company {
  id                                     String                    @id @default(uuid()) @db.Uuid
  workspaceId                            String                    @map("workspace_id") @db.Uuid
  name                                   String
  normalizedName                         String                    @map("normalized_name")
  domain                                 String?
  website                                String?
  description                            String?
  country                                String?
  city                                   String?
  employeeRange                          String?                   @map("employee_range")
  companyType                            String?                   @map("company_type")
  agencyType                             String?                   @map("agency_type")
  services                               Json                      @default("[]")
  technologies                           Json                      @default("[]")
  industries                             Json                      @default("[]")
  hasWebService                          Boolean                   @default(false) @map("has_web_service")
  hasBackendService                      Boolean                   @default(false) @map("has_backend_service")
  hasMobileService                       Boolean                   @default(false) @map("has_mobile_service")
  hasFlutterService                      Boolean                   @default(false) @map("has_flutter_service")
  hasAndroidService                      Boolean                   @default(false) @map("has_android_service")
  hasIosService                          Boolean                   @default(false) @map("has_ios_service")
  mobileCapabilityConfidence             Int                       @default(0) @map("mobile_capability_confidence")
  companyQualityScore                    Int                       @default(0) @map("company_quality_score")
  partnershipFitScore                    Int                       @default(0) @map("partnership_fit_score")
  companyAnalysisConfidence              Int                       @default(0) @map("company_analysis_confidence")
  companyAnalysisSummary                 String?                   @map("company_analysis_summary")
  analysisStatus                         AnalysisStatus            @default(NOT_ANALYZED) @map("analysis_status")
  analyzedAt                             DateTime?                 @map("analyzed_at")
  contentHash                            String?                   @map("content_hash")
  aiModel                                String?                   @map("ai_model")
  promptVersion                          String?                   @map("prompt_version")
  discoveryCount                         Int                       @default(0) @map("discovery_count")
  lastDiscoveredAt                       DateTime?                 @map("last_discovered_at")
  duplicateConfidence                    Int                       @default(0) @map("duplicate_confidence")
  preQualificationScore                  Int                       @default(0) @map("pre_qualification_score")
  mobileOutsourcingOpportunityConfidence Int                       @default(0) @map("mobile_outsourcing_opportunity_confidence")
  enrichmentStatus                       String?                   @map("enrichment_status")
  firstDiscoveredAt                      DateTime                  @default(now()) @map("first_discovered_at")
  lastAnalyzedAt                         DateTime?                 @map("last_analyzed_at")
  createdAt                              DateTime                  @default(now()) @map("created_at")
  updatedAt                              DateTime                  @updatedAt @map("updated_at")
  workspace                              Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts                               Contact[]
  leads                                  Lead[]
  enrichmentRecords                      ContactEnrichmentRecord[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, normalizedName])
  @@index([workspaceId, country])
  @@map("companies")
}

model Contact {
  id                       String                    @id @default(uuid()) @db.Uuid
  workspaceId              String                    @map("workspace_id") @db.Uuid
  companyId                String?                   @map("company_id") @db.Uuid
  fullName                 String                    @map("full_name")
  role                     String?
  email                    String?
  emailStatus              EmailStatus               @default(UNKNOWN) @map("email_status")
  emailSource              String?                   @map("email_source")
  source                   String?
  verifiedAt               DateTime?                 @map("verified_at")
  verificationProvider     String?                   @map("verification_provider")
  verificationResult       Json                      @default("{}") @map("verification_result")
  linkedinUrl              String?                   @map("linkedin_url")
  xUrl                     String?                   @map("x_url")
  redditUsername           String?                   @map("reddit_username")
  telegramUsername         String?                   @map("telegram_username")
  profileUrl               String?                   @map("profile_url")
  decisionMakerScore       Int                       @default(0) @map("decision_maker_score")
  contactConfidence        Int                       @default(0) @map("contact_confidence")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company                  Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads                    Lead[]
  outreach                 OutreachMessage[]
  replies                  EmailReply[]
  actionItems              ActionItem[]
  suppressionEntries       SuppressionEntry[]
  socialProfiles           SocialProfile[]
  emailVerificationRecords EmailVerificationRecord[]

  @@unique([workspaceId, email])
  @@index([workspaceId, companyId])
  @@index([workspaceId, fullName])
  @@map("contacts")
}

model RawLead {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  source           LeadSource
  searchQueryId    String?          @map("search_query_id") @db.Uuid
  discoveryRunId   String?          @map("discovery_run_id") @db.Uuid
  externalId       String?          @map("external_id")
  sourceUrl        String?          @map("source_url")
  title            String?
  description      String?
  domain           String?
  authorExternalId String?          @map("author_external_id")
  username         String?
  displayName      String?          @map("display_name")
  profileUrl       String?          @map("profile_url")
  engagement       Json             @default("{}")
  author           String?
  content          String
  rejectionReason  String?          @map("rejection_reason")
  publishedAt      DateTime?        @map("published_at")
  rawPayload       Json             @default("{}") @map("raw_payload")
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  createdAt        DateTime         @default(now()) @map("created_at")
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  searchQuery      SearchQuery?     @relation(fields: [searchQueryId], references: [id], onDelete: SetNull)
  discoveryRun     DiscoveryRun?    @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  signals          LeadSignal[]

  @@unique([workspaceId, source, externalId])
  @@index([workspaceId, processingStatus])
  @@map("raw_leads")
}

model Lead {
  id                          String                  @id @default(uuid()) @db.Uuid
  workspaceId                 String                  @map("workspace_id") @db.Uuid
  companyId                   String?                 @map("company_id") @db.Uuid
  contactId                   String?                 @map("contact_id") @db.Uuid
  primarySearchQueryId        String?                 @map("primary_search_query_id") @db.Uuid
  discoveryRunId              String?                 @map("discovery_run_id") @db.Uuid
  primarySignalId             String?                 @map("primary_signal_id") @db.Uuid
  primarySource               LeadSource              @default(MANUAL) @map("primary_source")
  leadType                    LeadType                @default(MANUAL) @map("lead_type")
  title                       String
  opportunitySummary          String?                 @map("opportunity_summary")
  recommendedPitch            String?                 @map("recommended_pitch")
  sourceUrl                   String?                 @map("source_url")
  sourceContent               String?                 @map("source_content")
  publishedAt                 DateTime?               @map("published_at")
  analysisStatus              AnalysisStatus          @default(NOT_ANALYZED) @map("analysis_status")
  analysisConfidence          Int                     @default(0) @map("analysis_confidence")
  analysisSummary             String?                 @map("analysis_summary")
  socialPreQualificationScore Int                     @default(0) @map("social_pre_qualification_score")
  opportunityUrgency          OpportunityUrgency      @default(UNKNOWN) @map("opportunity_urgency")
  buyerIntentScore            Int                     @default(0) @map("buyer_intent_score")
  selfPromotionProbability    Int                     @default(0) @map("self_promotion_probability")
  socialSpamProbability       Int                     @default(0) @map("social_spam_probability")
  sourceCount                 Int                     @default(1) @map("source_count")
  evidence                    Json                    @default("{}")
  aiInterpretation            Json                    @default("{}") @map("ai_interpretation")
  unknowns                    Json                    @default("[]")
  invalidReason               InvalidLeadReason?      @map("invalid_reason")
  outreachRecommendation      OutreachRecommendation? @map("outreach_recommendation")
  recommendedChannel          RecommendedChannel?     @map("recommended_channel")
  scoreOverrideOriginal       Int?                    @map("score_override_original")
  scoreOverrideScore          Int?                    @map("score_override_score")
  scoreOverrideReason         String?                 @map("score_override_reason")
  scoreOverriddenByUserId     String?                 @map("score_overridden_by_user_id") @db.Uuid
  scoreOverriddenAt           DateTime?               @map("score_overridden_at")
  aiModel                     String?                 @map("ai_model")
  promptVersion               String?                 @map("prompt_version")
  status                      LeadStatus              @default(NEW)
  temperature                 LeadTemperature         @default(REVIEW)
  overallScore                Int                     @default(0) @map("overall_score")
  rankingScore                Int                     @default(0) @map("ranking_score")
  rankReason                  Json                    @default("[]") @map("rank_reason")
  rankBreakdown               Json                    @default("{}") @map("rank_breakdown")
  staleAt                     DateTime?               @map("stale_at")
  reactivatedAt               DateTime?               @map("reactivated_at")
  firstDiscoveredAt           DateTime                @default(now()) @map("first_discovered_at")
  lastSignalAt                DateTime                @default(now()) @map("last_signal_at")
  createdAt                   DateTime                @default(now()) @map("created_at")
  updatedAt                   DateTime                @updatedAt @map("updated_at")
  workspace                   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company                     Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact                     Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  signals                     LeadSignal[]
  scores                      LeadScore[]
  outreach                    OutreachMessage[]
  replies                     EmailReply[]
  feedback                    LeadFeedback[]
  activities                  Activity[]
  actions                     ActionItem[]
  primarySearchQuery          SearchQuery?            @relation(fields: [primarySearchQueryId], references: [id], onDelete: SetNull)
  discoveryRun                DiscoveryRun?           @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  shortlistItems              ShortlistItem[]

  @@index([workspaceId, status])
  @@index([workspaceId, temperature])
  @@index([workspaceId, overallScore])
  @@index([workspaceId, rankingScore])
  @@index([workspaceId, primarySource])
  @@index([workspaceId, createdAt])
  @@map("leads")
}

model LeadSignal {
  id                          String             @id @default(uuid()) @db.Uuid
  workspaceId                 String             @map("workspace_id") @db.Uuid
  leadId                      String             @map("lead_id") @db.Uuid
  rawLeadId                   String?            @map("raw_lead_id") @db.Uuid
  searchQueryId               String?            @map("search_query_id") @db.Uuid
  discoveryRunId              String?            @map("discovery_run_id") @db.Uuid
  source                      LeadSource
  signalType                  String             @map("signal_type")
  content                     String
  sourceUrl                   String?            @map("source_url")
  profileUrl                  String?            @map("profile_url")
  authorExternalId            String?            @map("author_external_id")
  username                    String?
  displayName                 String?            @map("display_name")
  authorType                  String?            @map("author_type")
  authorTypeConfidence        Int                @default(0) @map("author_type_confidence")
  opportunityUrgency          OpportunityUrgency @default(UNKNOWN) @map("opportunity_urgency")
  signalQualityScore          Int                @default(0) @map("signal_quality_score")
  socialPreQualificationScore Int                @default(0) @map("social_pre_qualification_score")
  metadata                    Json               @default("{}")
  publishedAt                 DateTime?          @map("published_at")
  signalScore                 Int                @default(0) @map("signal_score")
  createdAt                   DateTime           @default(now()) @map("created_at")
  workspace                   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead                        Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rawLead                     RawLead?           @relation(fields: [rawLeadId], references: [id], onDelete: SetNull)
  searchQuery                 SearchQuery?       @relation(fields: [searchQueryId], references: [id], onDelete: SetNull)
  discoveryRun                DiscoveryRun?      @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)

  @@index([workspaceId, leadId])
  @@map("lead_signals")
}

model LeadScore {
  id                    String              @id @default(uuid()) @db.Uuid
  workspaceId           String              @map("workspace_id") @db.Uuid
  leadId                String              @map("lead_id") @db.Uuid
  buyingIntent          Int                 @default(0) @map("buying_intent")
  mobileRelevance       Int                 @default(0) @map("mobile_relevance")
  agencyFit             Int                 @default(0) @map("agency_fit")
  decisionMakerQuality  Int                 @default(0) @map("decision_maker_quality")
  contactability        Int                 @default(0)
  recency               Int                 @default(0)
  companyQuality        Int                 @default(0) @map("company_quality")
  countryPriority       Int                 @default(0) @map("country_priority")
  spamProbability       Int                 @default(0) @map("spam_probability")
  competitorProbability Int                 @default(0) @map("competitor_probability")
  baseScore             Int                 @default(0) @map("base_score")
  penalty               Int                 @default(0)
  overall               Int
  temperature           LeadTemperature     @default(REVIEW)
  reason                String?
  recommendedChannel    RecommendedChannel? @map("recommended_channel")
  recommendedPitch      String?             @map("recommended_pitch")
  confidence            Int                 @default(0)
  explanation           String?
  aiModel               String?             @map("ai_model")
  promptVersion         String?             @map("prompt_version")
  isManualOverride      Boolean             @default(false) @map("is_manual_override")
  overrideOriginalScore Int?                @map("override_original_score")
  overrideScore         Int?                @map("override_score")
  overrideReason        String?             @map("override_reason")
  overrideByUserId      String?             @map("override_by_user_id") @db.Uuid
  overriddenAt          DateTime?           @map("overridden_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead                  Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, leadId])
  @@map("lead_scores")
}

model SearchQuery {
  id                  String              @id @default(uuid()) @db.Uuid
  workspaceId         String              @map("workspace_id") @db.Uuid
  source              LeadSource
  query               String
  enabled             Boolean             @default(true)
  priority            Int                 @default(0)
  country             String?
  category            String              @default("CUSTOM")
  lastRun             DateTime?           @map("last_run")
  lastRunAt           DateTime?           @map("last_run_at")
  lastResultCount     Int                 @default(0) @map("last_result_count")
  totalResults        Int                 @default(0) @map("total_results")
  relevantResults     Int                 @default(0) @map("relevant_results")
  prequalifiedResults Int                 @default(0) @map("prequalified_results")
  uniqueCompanies     Int                 @default(0) @map("unique_companies")
  shortlisted         Int                 @default(0)
  manualActions       Int                 @default(0) @map("manual_actions")
  qualityScore        Int                 @default(0) @map("quality_score")
  lowPerformance      Boolean             @default(false) @map("low_performance")
  resultsFound        Int                 @default(0) @map("results_found")
  qualifiedResults    Int                 @default(0) @map("qualified_results")
  responses           Int                 @default(0)
  conversions         Int                 @default(0)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rawLeads            RawLead[]
  leads               Lead[]
  signals             LeadSignal[]
  discoveryQueryRuns  DiscoveryQueryRun[]

  @@unique([workspaceId, source, query])
  @@map("search_queries")
}

model Campaign {
  id                String            @id @default(uuid()) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  name              String
  strategy          String            @default("AGENCY_PARTNERSHIP")
  status            String            @default("DRAFT")
  minimumScore      Int               @default(82) @map("minimum_score")
  shortlistLimit    Int               @default(20) @map("shortlist_limit")
  weeklyLimit       Int               @default(20) @map("weekly_limit")
  emailMode         String            @default("DRAFT_FIRST") @map("email_mode")
  autoSendEnabled   Boolean           @default(false) @map("auto_send_enabled")
  autoSendThreshold Int               @default(92) @map("auto_send_threshold")
  followUpDays      Int               @default(7) @map("follow_up_days")
  followUpMode      String            @default("DRAFT") @map("follow_up_mode")
  maxFollowUps      Int               @default(1) @map("max_follow_ups")
  targeting         Json              @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outreach          OutreachMessage[]

  @@index([workspaceId, status])
  @@map("campaigns")
}

model OutreachMessage {
  id                       String                 @id @default(uuid()) @db.Uuid
  workspaceId              String                 @map("workspace_id") @db.Uuid
  leadId                   String                 @map("lead_id") @db.Uuid
  contactId                String?                @map("contact_id") @db.Uuid
  campaignId               String?                @map("campaign_id") @db.Uuid
  followUpToId             String?                @map("follow_up_to_id") @db.Uuid
  channel                  OutreachChannel
  strategy                 String                 @default("AGENCY_PARTNERSHIP")
  messageType              String                 @map("message_type")
  subject                  String?
  body                     String
  originalGeneratedSubject String?                @map("original_generated_subject")
  originalGeneratedBody    String?                @map("original_generated_body")
  personalizationPoints    Json                   @default("[]") @map("personalization_points")
  confidence               Int                    @default(0)
  approvalStatus           OutreachApprovalStatus @default(PENDING) @map("approval_status")
  status                   OutreachStatus         @default(GENERATED)
  gmailDraftId             String?                @map("gmail_draft_id")
  gmailMessageId           String?                @map("gmail_message_id")
  gmailThreadId            String?                @map("gmail_thread_id")
  gmailHeaderMessageId     String?                @map("gmail_header_message_id")
  generatedByModel         String?                @map("generated_by_model")
  promptVersion            String?                @map("prompt_version")
  idempotencyKey           String?                @map("idempotency_key")
  generatedAt              DateTime?              @map("generated_at")
  approvedAt               DateTime?              @map("approved_at")
  sentAt                   DateTime?              @map("sent_at")
  repliedAt                DateTime?              @map("replied_at")
  followUpNumber           Int                    @default(0) @map("follow_up_number")
  failureReason            String?                @map("failure_reason")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  workspace                Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead                     Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact                  Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign                 Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
