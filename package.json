{
  "name": "scrapo-lead-hunter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -n web,api,worker -c blue,green,magenta \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:web": "pnpm --filter @scrapo/web dev",
    "dev:api": "pnpm --filter @scrapo/api dev",
    "dev:worker": "pnpm --filter @scrapo/worker dev",
    "build": "pnpm -r --if-present build",
    "start:web": "pnpm --filter @scrapo/web start",
    "start:api": "pnpm --filter @scrapo/api start",
    "start:worker": "pnpm --filter @scrapo/worker start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @scrapo/api test:e2e",
    "security:secrets": "node scripts/secret-scan.mjs",
    "openapi:postman": "node scripts/openapi-to-postman.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @scrapo/database generate && pnpm --filter @scrapo/api exec prisma generate --schema ../../packages/database/prisma/schema.prisma && pnpm --filter @scrapo/worker exec prisma generate --schema ../../packages/database/prisma/schema.prisma",
    "db:migrate": "pnpm --filter @scrapo/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @scrapo/database migrate:deploy",
    "db:seed": "pnpm --filter @scrapo/database seed",
    "db:studio": "pnpm --filter @scrapo/database studio"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
