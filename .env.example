# Copy the relevant values into apps/api/.env, apps/worker/.env, and apps/web/.env.local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scrapo?schema=public"
REDIS_URL="redis://localhost:6379"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-legacy-jwt-secret-if-used"
WEB_APP_URL="http://localhost:3000"
API_PORT="4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
DEMO_AUTH_ENABLED="true"
NEXT_PUBLIC_DEMO_MODE="true"
